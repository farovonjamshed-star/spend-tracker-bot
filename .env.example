# GEMINI_API_KEY: Required for AI receipt OCR and intelligent categorization
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public domain where this WebApp is hosted (e.g. Render.com URL)
APP_URL="https://spend-tracker-bot-v87h.onrender.com"

# TELEGRAM_BOT_TOKEN / BOT_TOKEN: Token from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# DATABASE_URL: Database connection string (optional; defaults to local file database with strict user isolation in ./data)
DATABASE_URL="file:./data/database.json"

# ADMIN_SECRET: Required to access protected bot configuration endpoints
ADMIN_SECRET="replace-with-a-long-random-secret"

# TELEGRAM_WEBHOOK_SECRET: Required only when using Telegram webhooks
TELEGRAM_WEBHOOK_SECRET="replace-with-telegram-webhook-secret"

# PORT: Server port (defaults to 3000)
PORT=3000

